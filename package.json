{
  "name": "snake-game",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "python3 -m http.server 5173",
    "start": "electron electron/main.cjs",
    "build:mac": "electron-builder --mac --dir",
    "test": "node --test tests/*.test.js"
  },
  "devDependencies": {
    "electron": "^29.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.snakegame.classic",
    "productName": "Classic Snake",
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.html",
      "styles.css",
      "src/**/*",
      "electron/**/*",
      "package.json"
    ],
    "mac": {
      "target": [
        "dir"
      ]
    }
  }
}
